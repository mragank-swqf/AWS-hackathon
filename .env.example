# Copy to .env and fill in. Never commit real keys (spec 07 SEC-003).

# Database — use `postgres` as the host inside Docker, `localhost` on the host.
POSTGRES_USER=regimpact
POSTGRES_PASSWORD=regimpact
POSTGRES_DB=regimpact
DATABASE_URL=postgresql+psycopg2://regimpact:regimpact@localhost:5432/regimpact

# LocalStack for S3 + SQS. Dummy keys are fine. Do not point Bedrock at LocalStack.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_DOCUMENT_BUCKET=regimpact-documents
SQS_QUEUE_URL=http://localhost:4566/000000000000/regimpact-jobs

# Real AWS Bedrock in us-east-1 (Claude + Titan) — optional.
# Ship It: Bedrock is not required. OpenAI is used when quotas are blocked.
BEDROCK_LLM_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DEMO_COMPANY_ID=
DEMO_USER_ID=demo_user
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
