# Copy this file to .env and fill in local values.
# Never commit .env. LocalStack accepts any dummy AWS pair; do not use real keys.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=regimpact-documents
SQS_QUEUE_URL=http://localstack:4566/000000000000/regimpact-jobs

CHROMA_HOST=chroma
CHROMA_PORT=8000
